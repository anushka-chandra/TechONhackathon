# ─────────────────────────────────────────────────────────────────────────────
# Clarity — deployment environment variables
# Copy to `.env` for local dev (gitignored). On the hosts, paste into the
# platform dashboards (NOT into the repo).
# ─────────────────────────────────────────────────────────────────────────────

# ── RAILWAY (backend / FastAPI service) ──────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=google/gemini-2.5-flash

# Persist the SQLite database on a Railway Volume mounted at /data.
# (Omit to use the ephemeral container path; data is lost on each redeploy.)
DATABASE_URL=sqlite:////data/nexus.db

# Railway sets PORT automatically; the Dockerfile honours it (defaults to 8000).

# ── VERCEL (frontend / Next.js) ──────────────────────────────────────────────
# The public URL of the deployed Railway backend (no trailing slash).
NEXT_PUBLIC_BACKEND_URL=https://your-app.up.railway.app
